POSTGRES_DB=humite
POSTGRES_USER=humite
POSTGRES_PASSWORD=change-me-before-production
HUMITE_SESSION_COOKIE_SECURE=false
HUMITE_PUBLIC_BASE_URL=http://localhost:8080
# 留空时容器会在持久化数据卷中自动生成并复用 256 位随机密钥；生产环境也可手动指定（openssl rand -hex 32）。
HUMITE_AI_SETTINGS_ENCRYPTION_KEY=
HUMITE_TWO_FACTOR_ENCRYPTION_KEY=
HUMITE_HTTP_PORT=8080
HUMITE_LIBRARY_NAME=主书库
HUMITE_LIBRARY_MAIN=./data/library
# 上传文件使用流式写入；以下均可在 NAS 部署时调整。
HUMITE_UPLOAD_MAX_FILE_SIZE=2147483648
HUMITE_UPLOAD_MAX_BATCH_FILES=20
HUMITE_UPLOAD_RETENTION=24h
HUMITE_UPLOAD_MAX_COVER_SIZE=20971520
# Open Library 默认开启；Google Books 只在配置 API Key 后调用。
HUMITE_METADATA_OPEN_LIBRARY_ENABLED=true
HUMITE_METADATA_GOOGLE_API_KEY=
HUMITE_UID=1000
HUMITE_GID=1000
TZ=Asia/Shanghai
